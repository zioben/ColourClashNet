<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ColourClashNetCli</AssemblyName>
    <RootNamespace>ColourClash</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ColourClashLib\ColourClashLib.csproj" />
    <ProjectReference Include="..\ColourClashProcessing\ColourClashProcessing.csproj" />
    <ProjectReference Include="..\ColourClashSupport\ColourClashSupport.csproj" />
  </ItemGroup>

  <!-- Example pipelines and their images, copied next to the executable (output folders excluded) -->
  <ItemGroup>
    <None Include="PipelineExamples\**\*" Exclude="PipelineExamples\**\output\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
