// One image, four platforms: every Load starts again from the original image.
{
  "Version": 1,
  "Name": "Multi platform",
  "Steps": [
    { "$type": "Load", "File": "../Images/photo.png", "Label": "ZX Spectrum" },
    { "$type": "Resize", "Width": 256, "Height": 0, "Mode": "Average" },
    { "$type": "Crop", "X": 0, "Y": 96, "Width": 256, "Height": 192 },
    { "$type": "Transform", "Options": { "$type": "ZxSpectrum", "Autotune": "Fast" } },
    { "$type": "Save", "File": "output/multi-zx.png" },

    { "$type": "Load", "File": "../Images/photo.png", "Label": "C64 multicolor" },
    { "$type": "Resize", "Width": 320, "Height": 0, "Mode": "Average" },
    { "$type": "Crop", "X": 0, "Y": 140, "Width": 320, "Height": 200 },
    { "$type": "Transform", "Options": { "$type": "C64", "VideoMode": "Multicolor" } },
    { "$type": "Save", "File": "output/multi-c64.png" },

    { "$type": "Load", "File": "../Images/photo.png", "Label": "Amstrad CPC mode 1" },
    { "$type": "Resize", "Width": 320, "Height": 0, "Mode": "Average" },
    { "$type": "Crop", "X": 0, "Y": 140, "Width": 320, "Height": 200 },
    { "$type": "Transform", "Options": { "$type": "Cpc", "VideoMode": "Mode1", "Dithering": { "DitheringType": "Ordered_4x4" } } },
    { "$type": "Save", "File": "output/multi-cpc.png" },

    { "$type": "Load", "File": "../Images/photo.png", "Label": "Amiga HAM6" },
    { "$type": "Resize", "Width": 320, "Height": 0, "Mode": "Average" },
    { "$type": "Transform", "Options": { "$type": "Amiga", "VideoMode": "Ham6" } },
    { "$type": "Save", "File": "output/multi-amiga.png" }
  ]
}
