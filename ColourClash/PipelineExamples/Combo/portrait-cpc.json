// Ellipse portrait on a magenta background, background replaced with black, then Amstrad CPC mode 0.
{
  "Version": 1,
  "Name": "Portrait for the CPC",
  "Steps": [
    { "$type": "Load", "File": "../Images/photo.png" },
    { "$type": "Roi", "Shape": "Ellipse", "X": 28, "Y": 40, "Width": 200, "Height": 260, "OutsideColor": "#FF00FF" },
    {
      "$type": "Transform",
      "Label": "magenta outside the ellipse becomes black",
      "Options": { "$type": "BackgroundRemoval", "BackgroundColors": [ "#FF00FF" ], "ReplacementColor": "#000000" }
    },
    { "$type": "Resize", "Width": 160, "Height": 0, "Mode": "Average" },
    { "$type": "Transform", "Options": { "$type": "Cpc", "VideoMode": "Mode0" } },
    { "$type": "Save", "File": "output/portrait-cpc.png" }
  ]
}
