// HSV adjustment: hue rotation and saturation boost (no color reduction).
{
  "Version": 1,
  "Name": "HSV boost",
  "Steps": [
    { "$type": "Load", "File": "../Images/photo.png" },
    { "$type": "Transform", "Options": { "$type": "Hsv", "HueShift": 30, "SaturationFactor": 1.4, "BrightnessFactor": 1.05 } },
    { "$type": "Save", "File": "output/hsv-boost.png" }
  ]
}
