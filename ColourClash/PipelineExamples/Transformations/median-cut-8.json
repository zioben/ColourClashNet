// Median cut reduction to 8 colors, ordered 4x4 dithering.
{
  "Version": 1,
  "Name": "Median cut, 8 colors",
  "Steps": [
    { "$type": "Load", "File": "../Images/photo.png" },
    {
      "$type": "Transform",
      "Options": { "$type": "MedianCut", "MaxColors": 8, "Dithering": { "DitheringType": "Ordered_4x4" } }
    },
    { "$type": "Save", "File": "output/median-cut-8.png" }
  ]
}
