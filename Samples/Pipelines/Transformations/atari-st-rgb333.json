// Atari ST: 512 color space (RGB333), then 16 colors on screen.
{
  "Version": 1,
  "Name": "Atari ST, 16 of 512 colors",
  "Steps": [
    { "$type": "Load", "File": "../../../Images/Original.png" },
    { "$type": "Resize", "Width": 320, "Height": 0, "Mode": "Average" },
    { "$type": "Crop", "X": 0, "Y": 140, "Width": 320, "Height": 200 },
    { "$type": "Transform", "Label": "512 color space", "Options": { "$type": "Quantization", "Mode": "RGB333" } },
    {
      "$type": "Transform",
      "Label": "16 colors on screen",
      "Options": { "$type": "Clustering", "MaxColors": 16, "Dithering": { "DitheringType": "Atkinson" } }
    },
    { "$type": "Save", "File": "output/atari-st.png" }
  ]
}
