// IBM CGA composite artifact colors (mode 4, palette 1): 16 colors at half horizontal resolution.
{
  "Version": 1,
  "Name": "CGA composite",
  "Steps": [
    { "$type": "Load", "File": "../../../Images/Original.png" },
    { "$type": "Resize", "Width": 320, "Height": 0, "Mode": "Average" },
    { "$type": "Crop", "X": 0, "Y": 140, "Width": 320, "Height": 200 },
    { "$type": "Transform", "Options": { "$type": "Cga", "VideoMode": "Composite_1", "OutputMode": "ProcessedImage" } },
    { "$type": "Save", "File": "output/cga-composite.png" }
  ]
}
